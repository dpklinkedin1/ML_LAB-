

x = list(map(float,input("Enter x value:").split()))
y = list(map(float,input("Enter y values:").split()))
 
n = len(x)
 
mx=sum(x)/n
my=sum(y)/n
 
 

 
num=0
den=0
 
for i in range(n):
    num += (x[i]-mx)*(y[i]-my)
    den+=(x[i]-mx)**2

m = num/den
c = (my)-(m * mx)
print("\nRegression equation:")
print(f"y = {m}x + {c}")
