

import numpy as np
from sklearn.linear_model import LinearRegression

x = np.array([
    [1000,2,10],
    [1500,3,5],    #[area,rooms,age]
    [1800,4,2],
    [1200,2,8],
    [2000,5,1]
])

y = np.array([200000,300000,1500000,700000,800000])

model = LinearRegression()

model.fit(x,y)  #train model

new_house = np.array([1600,3,4])
price = model.predict(new_house)

print("Pridcted house price=",price[0])
