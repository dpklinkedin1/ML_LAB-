from sklearn.neighbors import KNeighborsClassifier
import numpy as np

# Input features [height, weight]
X = np.array([
    [150, 50],
    [160, 60],
    [170, 65],
    [180, 80]
])

# Output (0 = Female, 1 = Male)
y = np.array([0, 0, 1, 1])

# Create model (K = 3)
model = KNeighborsClassifier(n_neighbors=3)

# Train model
model.fit(X, y)

# Predict
new_person = np.array([[165, 55]])
result = model.predict(new_person)

print("Predicted Class =", result[0])
